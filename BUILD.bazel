load("@rules_java//java:defs.bzl", "java_import")
load("@rules_palantir_java_format//:defs.bzl", "java_format_check")

package(default_visibility = ["//visibility:public"])

java_import(
    name = "core",
    jars = ["//tools/release:proton_core_jar"],
    srcjar = "//tools/release:proton_core_sources_jar",
    deps = [
        "//third_party/java:javapoet",
        "//third_party/java:jspecify",
    ],
)

java_import(
    name = "qa",
    jars = ["//tools/release:proton_qa_jar"],
    srcjar = "//tools/release:proton_qa_sources_jar",
    deps = [
        "//third_party/java:jspecify",
        "//third_party/java:testng",
    ],
)

alias(
    name = "buildifier",
    actual = "//tools:buildifier",
)

alias(
    name = "buildifier_check",
    actual = "//tools:buildifier_check",
)

test_suite(
    name = "all_tests",
    tests = [
        "//core/src/test/java/org/realityforge/proton:all_tests",
        "//qa/src/test/java/org/realityforge/proton/qa:all_tests",
        "//tools/release:all_tests",
    ],
)

java_format_check(
    name = "java_format_check",
    testonly = True,
    remediation = "tools/java_format.sh write",
    targets = [
        ":all_tests",
        "//core/src/main/java/org/realityforge/proton:core",
        "//qa/src/main/java/org/realityforge/proton/qa:qa",
        "//tools/release:dist",
        "//tools/release:javadoc_jar_builder",
    ],
)
